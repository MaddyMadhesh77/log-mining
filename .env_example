# ── Dataset ──────────────────────────────────────────────────────────────────
DATASET_DIR=data

# ── HDFS ─────────────────────────────────────────────────────────────────────
HDFS_NAMENODE_HOST=localhost
HDFS_NAMENODE_PORT=9000
HDFS_USER=manojlinux

# ── Kafka ─────────────────────────────────────────────────────────────────────
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_TOPIC_RAW=hdfs-raw-logs
KAFKA_TOPIC_PARSED=hdfs-parsed-logs
KAFKA_TOPIC_ALERTS=hdfs-anomaly-alerts
KAFKA_PRODUCER_RATE=1000

# ── Spark ─────────────────────────────────────────────────────────────────────
SPARK_MASTER=local[*]
SPARK_INTERVAL_SECS=10

# ── Elasticsearch ─────────────────────────────────────────────────────────────
ES_HOST=localhost
ES_PORT=9200
ES_USERNAME=elastic
ES_PASSWORD=

# ── Mining ────────────────────────────────────────────────────────────────────
FP_MIN_SUPPORT=0.005
FP_MIN_CONFIDENCE=0.5
PS_MIN_SUPPORT=0.005
PS_MAX_PATTERN_LEN=20
BKMEANS_K=8

# ── Anomaly Detection ─────────────────────────────────────────────────────────
IF_N_ESTIMATORS=100
IF_MAX_SAMPLES=50000
IF_SUBSAMPLE=0.8
POT_Q0=0.90
POT_RISK_LEVEL=0.01
POT_FALLBACK_PCT=97.0

# ── API ───────────────────────────────────────────────────────────────────────
API_HOST=0.0.0.0
API_PORT=8000
API_RELOAD=false
CORS_ORIGINS=http://localhost:5601,http://localhost:3000